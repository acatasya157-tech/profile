* =================================
   1. PENGATURAN DASAR
================================= */

:root {
    --cream: #f8f5ef;
    --white: #fffdf9;
    --gold: #b08d57;
    --dark: #35352f;
    --muted: #77756d;
    --border: #e5dccd;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: "DM Sans", sans-serif;
    background: var(--white);
    color: var(--dark);
    line-height: 1.8;
}

h1, h2, h3 {
    font-family: "Playfair Display", serif;
    font-weight: 400;
    line-height: 1.3;
}

h2 {
    font-size: clamp(28px, 4vw, 40px);
    margin: 12px 0 20px;
}

p {
    color: var(--muted);
}

a {
    text-decoration: none;
}

/* =================================
   2. NAVIGASI
==============…
.navbar {
    width: 100%;
    padding: 18px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 253, 249, 0.96);
    border-bottom: 1px solid var(--border);
}

.logo {
    font-family: "Playfair Display", serif;
    font-size: 27px;
    color: var(--dark);
}

.logo span,
.hero h1 span,
.footer h2 span {
    color: var(--gold);
}

.nav-links {
    display: flex;
    gap: 28px;
}

.nav-links a {
    font-size: 13px;
    color: var(--dark);
    transition: color 0.3s;
}

.nav-links a:hover {
    color: var(--gold);
}

/* =================================
   3. HERO / SAMPUL UTAMA
================================= */

.hero {
    min-height: 88vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 80px 20px;

    background:
        linear-gradient(
            rgba(34, 32, 27, 0.43),
            rgba(34, 32, 27, 0.53)
        ),
        url("https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=2000&q=85");

    background-size: cover;
    background-position: center;
    color: white;
}

.hero-content {
    max-width: 700px;
    animation: fadeUp 1.2s ease;
}

.eyebrow {
    color: var(--gold);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 4px;
    text-transform: uppercase;
}

.hero .eyebrow {
    color: #f0d9ad;
}

.hero h1 {
    font-size: clamp(48px, 9vw, 86px);
    margin: 22px 0;
}

.hero-description {
    color: #f6f2eb;
    font-size: 15px;
    margin-bottom: 30px;
}

.hero-date {
    display: inline-block;
    padding: 12px 22px;
    margin-bottom: 30px;
    border-top: 1px solid #d7bc8d;
    border-bottom: 1px solid #d7bc8d;
    font-size: 12px;
    letter-spacing: 2px;
}

/* =================================
   4. TOMBOL
================================= */

.button {
    display: inline-block;
    padding: 13px 27px;
    background: var(--gold);
    color: white;
    font-size: 13px;
    border: 1px solid var(--gold);
    border-radius: 3px;
    transition: 0.3s;
}

.button:hover {
    background: transparent;
    color: var(--gold);
}

.hero .button:hover {
    color: white;
    border-color: white;
}

/* =================================
   5. SECTION UMUM
================================= */

.section {
    padding: 95px 8%;
    text-align: center;
}

.section > p:not(.eyebrow) {
    max-width: 650px;
    margin: 0 auto;
    font-size: 14px;
}

.ornament {
    color: var(--gold);
    font-size: 23px;
    margin-top: 25px;
}

/* =================================
   6. PEMBUKAAN
================================= */

.intro {
    background: var(--cream);
}

.intro h2 {
    max-width: 600px;
    margin: 18px auto;
}

/* =================================
   7. MEMPELAI
================================= */

.couple {
    background: var(--white);
}

.couple-container {
    max-width: 850px;
    margin: 50px auto 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
}

.person {
flex: 1;
    max-width: 300px;
}

.person img {
    width: 220px;
    height: 270px;
    max-width: 100%;
    object-fit: cover;
    border-radius: 110px 110px 5px 5px;
    border: 5px solid var(--cream);
    outline: 1px solid var(--border);
    margin-bottom: 22px;
}

.person h3 {
    font-size: 25px;
    margin-bottom: 5px;
}

.person p {
    font-size: 13px;
}

.person .role {
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 12px;
}

.ampersand {
    font-family: "Playfair Display", serif;
    font-size: 45px;
    color: var(--gold);
}

/* =================================
   8. CERITA CINTA
================================= */

.story {
    background: var(--cream);
}

.story h2 {
    margin-bottom: 25px;
}

/* =================================
   9. DETAIL ACARA
================================= */

.event {
    background: var(--white);
}

.event-container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 25px;
    max-width: 850px;
    margin: 40px auto 0;
}

.event-card {
    padding: 35px 22px;
    background: var(--cream);
    border: 1px solid var(--border);
    transition: transform 0.3s, box-shadow 0.3s;
}

.event-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(80, 65, 40, 0.08);
}

.event-icon {
    font-size: 30px;
    color: var(--gold);
    margin-bottom: 12px;
}

.event-card h3 {
    font-size: 25px;
    margin-bottom: 20px;
}

.event-card p {
    font-size: 13px;
}

.line {
    width: 45px;
    height: 1px;
    background: var(--gold);
    margin: 20px auto;
}

/* =================================
   10. LOKASI
================================= */

.location {
    background: var(--cream);
}

.location .button {
    margin-top: 25px;
}

/* =================================
   11. RSVP
================================= */

.rsvp {
    background: #3b3a32;
    color: white;
}

.rsvp h2 {
    color: white;
}

.rsvp > p:not(.eyebrow) {
    color: #d6d1c7;
}

.rsvp .button {
    margin-top: 28px;
}

/* =================================
   12. FOOTER
================================= */

.footer {
    padding: 55px 8% 25px;
    text-align: center;
    background: var(--white);
}

.footer h2 {
    font-size: 37px;
    margin: 15px 0;
}

.footer > p {
    max-width: 550px;
    margin: 0 auto;
    font-size: 13px;
}

.footer .thanks {
    margin-top: 12px;
    color: var(--gold);
}

.copyright {
    margin-top: 35px !important;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 11px !important;
}

/* =================================
   13. ANIMASI
================================= */

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* =================================
   14. RESPONSIVE UNTUK HP
================================= */

@media (max-width: 650px) {
    .navbar {
        padding: 14px 5%;
    }

    .logo {
        font-size: 23px;
    }

    .nav-links {
        gap: 12px;
}

    .hero {
        min-height: 82vh;
        padding: 60px 20px;
    }

    .hero h1 {
        font-size: 51px;
    }

    .hero-date {
        font-size: 10px;
        letter-spacing: 1px;
    }

    .section {
        padding: 70px 6%;
    }

    .couple-container {
        flex-direction: column;
        gap: 28px;
    }

    .person {
        width: 100%;
    }

    .person img {
        width: 200px;
        height: 240px;
    }

    .ampersand {
        font-size: 35px;
    }

    .event-container {
        grid-template-columns: 1fr;
    }

    .event-card {
        padding: 30px 15px;
    }
}

@media (max-width: 360px) {
    .nav-links {
        gap: 8px;
    }

    .nav-links a {
        font-size: 10px;
    }

    .hero h1 {
        font-size: 42px;
    }
}
